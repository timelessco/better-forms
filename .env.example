# Database URL for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better-forms"

# Direct Postgres connection for drizzle-kit (Supabase: use port 5432, not the
# 6543 transaction pooler). Required for any drizzle-kit operation.
DIRECT_URL=

# AI form generation (Vercel AI SDK)
AI_PROVIDER=openai   # or "google"
AI_API_KEY=          # provider API key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=         # optional: custom OpenAI-compatible endpoint

# File uploads (Vercel Blob)
BETTER_FORM_READ_WRITE_TOKEN=

# Transactional email (Resend) — magic links / OTP
RESEND_API_KEY=

# Better Auth Configuration
# Generate a secret key using: openssl rand -base64 32
BETTER_AUTH_SECRET="6ZSkfc+JSubEYM5tGZN86uivx6LGYJT/AcHWhXyDqKA="

# Better Auth Base URL (your app URL)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth Configuration
# Get credentials from: https://developer.apple.com
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Sentry Configuration (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App Branding
VITE_APP_NAME=Reform
VITE_APP_WEBSITE_URL=https://betterforms.com
VITE_APP_DOCS_URL=https://docs.betterforms.com
VITE_APP_API_DOCS_URL=https://developers.betterforms.so

# Custom Domains (Vercel API)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cron authorization. Required: scheduled jobs reject requests without this bearer token.
# On Vercel, set this in the project env and Vercel auto-sends `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -base64 32
CRON_SECRET=
