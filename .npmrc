# Quarantine fresh registry publishes for 7 days to defend against
# supply-chain attacks (compromised packages are typically detected,
# flagged, and deprecated well within this window). pnpm will refuse
# to resolve to versions newer than this threshold and fall back to
# the next-older version that satisfies the semver range.
minimum-release-age=10080
minimum-release-age-exclude=

# Strict peer-dep resolution catches incompatible upgrades early.
strict-peer-dependencies=false

# Expose transitive `@tanstack/*` packages at the node_modules root so
# direct imports keep resolving (the codebase imports
# `@tanstack/query-core` through transitive resolution). Future audit
# can promote these to direct dependencies and drop this rule.
public-hoist-pattern[]=@tanstack/*
