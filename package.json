{
  "name": "Reform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000}",
    "dev:auto": "p=3000; while lsof -iTCP:$p -sTCP:LISTEN >/dev/null 2>&1; do p=$((p+1)); done; PORT=$p pnpm dev",
    "dev:worktree": "cp -f /Users/vijayabaskar/work/better-form/.env .env && pnpm dev:auto",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "oxlint --type-aware --type-check",
    "lint": "oxlint --type-aware && knip --strict --use-tsconfig-files",
    "lint:fix": "oxlint --type-aware --fix",
    "knip": "knip --strict --use-tsconfig-files",
    "knip:fix": "knip --fix --use-tsconfig-files",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run fmt:check && pnpm run lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:reset": "tsx scripts/nuke-db.ts && drizzle-kit push --force && tsx scripts/seed-dev.ts",
    "build:embed": "esbuild src/embed/embed-popup.ts --bundle --minify --outfile=public/embed/popup.js --target=es2020 --format=iife && esbuild src/embed/embed-standard.ts --bundle --minify --outfile=public/widgets/embed.js --target=es2020 --format=iife",
    "build": "pnpm run build:embed && NODE_OPTIONS='--max-old-space-size=12288' vite build",
    "start": "node .output/server/index.mjs",
    "fix": "pnpm run fmt && pnpm run lint:fix"
  },
